<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox fx:id="root" alignment="CENTER" spacing="10"
      prefWidth="1024" prefHeight="768"
      xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="customer.screen.controller.ViewStoreController">
    
    <!-- HBox: Tiêu đề và nút View Cart -->
    <HBox alignment="CENTER" spacing="10">
        <children>
            <Label text="AIMS" style="-fx-font-size: 50px; -fx-text-fill: #004cff"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="View Cart" fx:id="btnViewCart" prefWidth="100" prefHeight="50" onAction="#btnViewCartPressed"/>
        </children>
        <padding><Insets left="20" right="20"/></padding>
    </HBox>

    <!-- ScrollPane: Hiển thị danh sách sản phẩm -->
    <ScrollPane fitToWidth="true" prefHeight="700" prefWidth="1024">
        <content>
            <GridPane fx:id="gridPane" hgap="10" vgap="10" alignment="CENTER">
                <padding><Insets top="10" left="10" right="10" bottom="10"/></padding>
            </GridPane>
        </content>
    </ScrollPane>
</VBox>
