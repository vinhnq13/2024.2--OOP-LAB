<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" prefWidth="1024" prefHeight="768" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="customer.screen.controller.CartController">

    <!-- TOP AREA: Title and View Store Button -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" BorderPane.alignment="CENTER">
            <children>
                <Label text="CART" style="-fx-font-size: 50px; -fx-text-fill: #004cff"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnViewStore" text="View Store" prefWidth="100" prefHeight="50" onAction="#btnViewStorePressed"/>
            </children>
            <padding><Insets top="20" bottom="20" left="20" right="20"/></padding>
        </HBox>
    </top>

    <!-- CENTER AREA: Filter + TableView + Buttons -->
    <center>
        <VBox spacing="10" BorderPane.alignment="CENTER" padding="20">
            <children>
                <!-- FILTER AREA -->
                <HBox alignment="CENTER_LEFT" spacing="10" padding="10">
                    <children>
                        <Label text="Filter:"/>
                        <TextField fx:id="tfFilter"/>
                        <RadioButton fx:id="radioBtnFilterId" text="By ID" toggleGroup="$filterCategory" selected="true"/>
                        <RadioButton fx:id="radioBtnFilterTitle" text="By Title" toggleGroup="$filterCategory"/>
                    </children>
                </HBox>

                <!-- TABLEVIEW -->
                <TableView fx:id="tblMedia" prefHeight="400">
                    <columns>
                        <TableColumn fx:id="colMediaId" text="ID"/>
                        <TableColumn fx:id="colMediaTitle" text="Title"/>
                        <TableColumn fx:id="colMediaCategory" text="Category"/>
                        <TableColumn fx:id="colMediaCost" text="Cost"/>
                    </columns>
                </TableView>

                <!-- BUTTON BAR: Play & Remove -->
                <HBox alignment="TOP_RIGHT" spacing="20" padding="10">
                    <children>
                        <Button fx:id="btnPlay" text="Play" prefWidth="60" onAction="#btnPlayPressed" visible="false"/>
                        <Button fx:id="btnRemove" text="Remove" prefWidth="60" onAction="#btnRemovePressed" visible="false"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>

    <!-- BOTTOM AREA: Total Cost & Place Order -->
    <bottom>
        <VBox alignment="TOP_CENTER" spacing="30" prefHeight="200" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER" spacing="10">
                    <children>
                        <Label text="Total:" style="-fx-font-size: 24px; -fx-font-weight: bold"/>
                        <Label fx:id="costLabel" text="0 $" style="-fx-font-size: 24px; -fx-font-weight: bold"/>
                    </children>
                </HBox>
                <Button text="Place Order" style="-fx-font-size: 24px; -fx-text-fill: white; -fx-background-color: #004cff"/>
            </children>
        </VBox>
    </bottom>
</BorderPane>
