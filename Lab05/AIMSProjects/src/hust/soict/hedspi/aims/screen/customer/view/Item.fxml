<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="customer.screen.controller.ItemController"
            prefWidth="305" prefHeight="175">
    
    <VBox alignment="CENTER" spacing="10" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
        
        <!-- Tiêu đề -->
        <Label fx:id="lblTitle" text="Title" prefHeight="50" prefWidth="305" alignment="CENTER"/>

        <!-- Giá -->
        <Label fx:id="lblCost" text="Cost" prefHeight="50" prefWidth="305" alignment="CENTER"/>

        <!-- HBox: Button Add + Play -->
        <HBox alignment="CENTER" spacing="20" prefHeight="50" prefWidth="305">
            <Button fx:id="btnAddToCart" text="Add to Cart" prefWidth="120" onAction="#btnAddToCartClicked"/>
            <Button fx:id="btnPlay" text="Play" prefWidth="120" onAction="#btnPlayClicked" visible="false"/>
        </HBox>
    </VBox>
</AnchorPane>
